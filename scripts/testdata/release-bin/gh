#!/usr/bin/env bash
# Stands in for `gh release view` and `gh release download` in
# scripts/test-release-scripts.sh. The release's files are the ones in
# FAKE_GH_RELEASE. FAKE_GH_FAIL=view or FAKE_GH_FAIL=download makes that
# command fail as a network error would.
set -euo pipefail

: "${FAKE_GH_RELEASE:?}"
case "$*" in
  "release view "*" --json assets --jq .assets[].name")
    if [ "${FAKE_GH_FAIL:-}" = view ]; then
      echo "fake gh: connection reset" >&2
      exit 1
    fi
    ls -1 "${FAKE_GH_RELEASE}"
    ;;
  "release download "*" --pattern "*" --dir "*)
    if [ "${FAKE_GH_FAIL:-}" = download ]; then
      echo "fake gh: connection reset" >&2
      exit 1
    fi
    pattern="$5"
    dir="$7"
    if [ ! -f "${FAKE_GH_RELEASE}/${pattern}" ]; then
      echo "fake gh: no assets match the file pattern" >&2
      exit 1
    fi
    cp "${FAKE_GH_RELEASE}/${pattern}" "${dir}/"
    ;;
  *)
    echo "fake gh: unexpected arguments: $*" >&2
    exit 2
    ;;
esac
